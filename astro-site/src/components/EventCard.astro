---
import type { CollectionEntry } from 'astro:content';

type Event = CollectionEntry<'seasonGuides'>['data']['events'][number];

interface Props {
  event: Event;
  accent: string;
}

const { event, accent } = Astro.props;

const detailSections = [
  { label: '관람 포인트', items: event.bestSpots },
  { label: '먹거리', items: event.food },
].filter((s) => s.items.length > 0);
---

<article class="overflow-hidden rounded-3xl border border-slate-200 bg-white dark:border-white/10 dark:bg-white/5">
  <div class="p-6 sm:p-7">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full px-3 py-1 text-[11px] font-black" style={`background:${accent}1a;color:${accent}`}>
        📅 {event.dateLabel}
      </span>
      {event.scale && (
        <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-black text-slate-500 dark:bg-white/10 dark:text-slate-400">
          {event.scale}
        </span>
      )}
      {event.unescoHeritage && (
        <span class="rounded-full bg-amber-400/15 px-3 py-1 text-[11px] font-black text-amber-700 dark:text-amber-400">
          🏛️ 유네스코 무형유산
        </span>
      )}
    </div>

    <h3 class="mt-3 text-2xl font-black">{event.name}</h3>
    {event.nameJa && <p class="mt-0.5 text-sm text-slate-400">{event.nameJa}</p>}
    {event.summary && (
      <p class="mt-3 text-sm font-bold text-slate-600 dark:text-slate-300">{event.summary}</p>
    )}

    {event.note && (
      <p
        class="mt-4 rounded-xl px-4 py-3 text-sm font-bold"
        style={`background:${accent}12;color:${accent}`}
      >
        ⚠️ {event.note}
      </p>
    )}

    <div class="mt-5 rounded-xl bg-slate-50 px-4 py-3 dark:bg-white/5">
      <p class="text-sm font-black">📍 {event.venue.name}</p>
      {event.venue.access && (
        <p class="mt-1 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          🚉 {event.venue.access}
        </p>
      )}
    </div>

    {event.highlights.length > 0 && (
      <ul class="mt-5 space-y-1.5">
        {event.highlights.map((h) => (
          <li class="flex gap-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <span style={`color:${accent}`}>·</span>
            <span>{h}</span>
          </li>
        ))}
      </ul>
    )}

    {event.crowd && (
      <div class="mt-5">
        <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">혼잡도</p>
        <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{event.crowd}</p>
      </div>
    )}

    {event.tips.length > 0 && (
      <div class="mt-5">
        <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">알아두면 좋은 팁</p>
        <ul class="mt-2 space-y-1.5">
          {event.tips.map((tip) => (
            <li class="flex gap-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              <span style={`color:${accent}`}>·</span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {detailSections.length > 0 && (
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {detailSections.map((section) => (
          <div>
            <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">{section.label}</p>
            <div class="mt-2 space-y-2">
              {section.items.map((item) => (
                <div class="rounded-xl bg-slate-50 px-3 py-2.5 dark:bg-white/5">
                  <p class="text-sm font-black">{item.name}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    {(event.whatToWear || event.budget) && (
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {event.whatToWear && (
          <div class="rounded-xl border border-slate-200 px-4 py-3 dark:border-white/10">
            <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">복장</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300">{event.whatToWear}</p>
          </div>
        )}
        {event.budget && (
          <div class="rounded-xl border border-slate-200 px-4 py-3 dark:border-white/10">
            <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">예산</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300">{event.budget}</p>
          </div>
        )}
      </div>
    )}

    <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1.5">
        {event.tags.map((tag) => (
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-500 dark:bg-white/10 dark:text-slate-400">
            #{tag}
          </span>
        ))}
      </div>
      {event.officialUrl && (
        <a
          href={event.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-xs font-black no-underline hover:underline"
          style={`color:${accent}`}
        >
          공식 사이트 →
        </a>
      )}
    </div>
  </div>
</article>
