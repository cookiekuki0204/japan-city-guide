---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const neighborhoods = await getCollection('neighborhoods');
---

<BaseLayout
  title="동네 딥다이브"
  description="도쿄 가구라자카, 나카메구로 등 일본의 동네를 깊이 들여다보는 에디토리얼 가이드."
>
  <main class="mx-auto max-w-4xl px-6 pb-24 pt-16">
    <p class="text-xs font-black uppercase tracking-[0.25em] text-rose-500">
      Neighborhood Deep Dive
    </p>
    <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">동네 딥다이브</h1>
    <p class="mt-4 max-w-xl text-slate-600 dark:text-slate-300">
      도시 단위로는 담기지 않는, 한 동네를 깊이 들여다보는 기록.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {neighborhoods.map((n) => (
        <a
          href={`/neighborhoods/${n.id}`}
          class="rounded-3xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition-transform hover:-translate-y-1 dark:border-white/10 dark:bg-white/5"
        >
          <h2 class="text-xl font-black text-slate-900 dark:text-white">{n.data.title}</h2>
          {n.data.nameJa && <p class="mt-0.5 text-sm text-slate-400">{n.data.nameJa}</p>}
          <p class="mt-3 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            {n.data.description}
          </p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
