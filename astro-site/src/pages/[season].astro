---
import BaseLayout from '../layouts/BaseLayout.astro';
import WinterShopping from '../components/WinterShopping.astro';
import { getCollection } from 'astro:content';
import { SEASON_META, SEASON_TYPES } from '../lib/season';

export async function getStaticPaths() {
  return SEASON_TYPES.map((season) => ({ params: { season } }));
}

const { season } = Astro.params;
const meta = SEASON_META[season as keyof typeof SEASON_META];

const cities = (await getCollection('cities')).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('seasonGuides')).filter((g) => g.data.type === season);
---

<BaseLayout title={`일본 ${meta.label} 가이드`} description={meta.blurb} season={season as any}>
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-16">
    <div class="text-center">
      <div class="text-5xl">{meta.emoji}</div>
      <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">일본 {meta.label} 가이드</h1>
      <p class="mt-4 text-slate-600 dark:text-slate-300">{meta.blurb}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cities.map((city) => {
        const guide = guides.find((g) => g.data.cityId === city.id);
        return guide ? (
          <a
            href={`/${city.id}/${season}`}
            class="rounded-2xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition-transform hover:-translate-y-1 dark:border-white/10 dark:bg-white/5"
          >
            <span class="text-2xl">{city.data.emoji}</span>
            <h2 class="mt-2 text-lg font-black text-slate-900 dark:text-white">{city.data.name}</h2>
            <p class="mt-1 text-xs text-slate-400">
              {guide.data.events.length
                ? `행사 ${guide.data.events.length}개`
                : `명소 ${guide.data.spots.length}곳`}
            </p>
            <p class="mt-2 text-xs font-black uppercase tracking-wider" style={`color:${meta.accent}`}>
              {meta.label} 가이드 보기 →
            </p>
          </a>
        ) : (
          <div class="rounded-2xl border border-dashed border-slate-200 p-6 opacity-40 dark:border-white/10">
            <span class="text-2xl">{city.data.emoji}</span>
            <h2 class="mt-2 text-lg font-black">{city.data.name}</h2>
            <p class="mt-1 text-xs text-slate-400">준비중</p>
          </div>
        );
      })}
    </div>

    {season === 'winter' && <WinterShopping />}

    {season === 'winter' && (
      <p class="mt-10 rounded-2xl border border-slate-200 bg-white px-6 py-5 text-sm leading-relaxed text-slate-600 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
        📅 겨울 여행은 연말연시 연휴와 겹치기 쉽습니다.
        <a href="/holidays" class="font-black text-rose-500 no-underline hover:underline">
          일본 공휴일 일정
        </a>
        에서 붐비는 기간을 먼저 확인하세요.
      </p>
    )}
  </main>
</BaseLayout>
