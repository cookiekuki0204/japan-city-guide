---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonHero from '../components/SeasonHero.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const cities = (await getCollection('cities')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="2026 일본 여행 마스터 가이드"
  description="2026 일본 여행 완벽 가이드. 도쿄·오사카·교토·후쿠오카 등 6개 도시의 벚꽃·마쓰리·하나비·단풍·겨울 정보와 동네 딥다이브까지 한번에."
>
  <main class="mx-auto max-w-6xl px-6 pb-24 pt-20">
    <div class="text-center">
      <h1 class="text-4xl font-black leading-tight tracking-tight sm:text-6xl">
        어디로 떠나시나요?
      </h1>
      <p class="mx-auto mt-6 mb-16 max-w-xl text-lg text-slate-600 dark:text-slate-300">
        도시별 사계절 가이드를 한 곳에서.
      </p>
    </div>

    <SeasonHero />

    <AdSlot name="home" />

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cities.map((city) => (
        <a
          href={`/${city.id}`}
          class="rounded-3xl border border-slate-200 bg-white p-7 no-underline shadow-sm transition-transform hover:-translate-y-1 dark:border-white/10 dark:bg-white/5"
        >
          <span class="text-3xl">{city.data.emoji}</span>
          <h2 class="mt-3 text-2xl font-black text-slate-900 dark:text-white">{city.data.name}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            {city.data.description}
          </p>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
