---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'neighborhoods'>;
  cityName: string;
}

const { entry, cityName } = Astro.props;
const {
  title, nameJa, nameEn, description, intro,
  heroImage, facts, route, seasons, cafes, restaurants, gallery, cards,
} = entry.data;

const hero = await resolveImage(heroImage);
const photos = (await Promise.all(gallery.map((g) => resolveImage(g)))).filter(Boolean);
const cardImages = (await Promise.all(cards.map((c) => resolveImage(c)))).filter(Boolean);

const eateries = [
  { label: '카페', items: cafes },
  { label: '맛집', items: restaurants },
].filter((g) => g.items.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${title} 여행 가이드`,
  description,
  about: { '@type': 'Place', name: title },
};
---

<BaseLayout title={title} description={description} image={heroImage}>
  <main class="neighborhood mx-auto max-w-3xl px-6 pb-24 pt-12">
    <a
      href={`/${entry.data.cityId}`}
      class="text-xs font-black uppercase tracking-wider text-slate-400 no-underline hover:text-[--accent]"
    >
      ← {cityName}
    </a>

    <p class="mt-8 text-[11px] font-black uppercase tracking-[0.25em] text-[--accent]">
      Neighborhood Deep Dive · {cityName}
    </p>
    <h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">{title}</h1>
    <p class="mt-2 font-serif text-lg tracking-[0.15em] text-slate-400">
      {nameJa}{nameEn && <span class="ml-3 text-base tracking-normal">{nameEn}</span>}
    </p>

    {hero && (
      <Image
        src={hero}
        alt={title}
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 720px, 100vw"
        quality={70}
        loading="eager"
        class="mt-8 aspect-[3/2] w-full rounded-3xl object-cover"
      />
    )}

    {facts.length > 0 && (
      <dl class="mt-8 flex gap-6 overflow-x-auto border-y border-slate-200 py-4 dark:border-white/10">
        {facts.map((f) => (
          <div class="shrink-0">
            <dt class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
              {f.label}
            </dt>
            <dd class="mt-1 font-serif text-sm font-semibold">{f.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {intro.length > 0 && (
      <div class="mt-10 space-y-5">
        {intro.map((p) => (
          <p class="text-[17px] leading-[1.9] text-slate-700 dark:text-slate-300">{p}</p>
        ))}
      </div>
    )}

    {route.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif text-2xl">걸어서 도는 순서</h2>
        <p class="mt-1 text-sm text-slate-400">시간은 참고용입니다. 순서만 따라가도 동선이 겹치지 않습니다.</p>
        <ol class="mt-6 border-l border-slate-200 dark:border-white/10">
          {route.map((stop, i) => (
            <li class="relative pb-7 pl-7 last:pb-0">
              <span
                class="absolute -left-[13px] top-0 flex size-6 items-center justify-center rounded-full bg-[--accent] text-[11px] font-black text-white"
              >
                {i + 1}
              </span>
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="font-black">{stop.name}</h3>
                {stop.time && (
                  <span class="text-xs font-bold tabular-nums text-slate-400">{stop.time}</span>
                )}
                {stop.badge && (
                  <span class="rounded-full bg-[--accent]/12 px-2 py-0.5 text-[10px] font-black text-[--accent]">
                    {stop.badge}
                  </span>
                )}
              </div>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                {stop.description}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {seasons.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif text-2xl">계절마다 달라지는 얼굴</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {seasons.map((s) => (
            <div class="rounded-2xl border border-slate-200 p-5 dark:border-white/10">
              <p class="text-xs font-black uppercase tracking-wider text-[--accent]">{s.season}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{s.note}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {eateries.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif text-2xl">먹고 마시기</h2>
        <div class="mt-6 grid gap-8 sm:grid-cols-2">
          {eateries.map((group) => (
            <div>
              <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">
                {group.label}
              </p>
              <ul class="mt-2 space-y-1">
                {group.items.map((e) => (
                  <li>
                    <a
                      href={e.link ??
                        `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.name} ${title}`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-baseline justify-between gap-3 rounded-lg px-2 py-1.5 no-underline transition-colors hover:bg-slate-50 dark:hover:bg-white/5"
                    >
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-bold text-slate-800 dark:text-slate-100">
                          {e.name}
                        </span>
                        <span class="block truncate text-xs text-slate-500 dark:text-slate-400">
                          {e.description}
                        </span>
                      </span>
                      {e.score && (
                        <span class="shrink-0 text-xs font-black tabular-nums text-[--accent]">
                          {e.score}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {photos.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif text-2xl">동네 풍경</h2>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {photos.map((photo, i) => (
            <Image
              src={photo!}
              alt={`${title} 풍경 ${i + 1}`}
              widths={[300, 600]}
              sizes="(min-width: 640px) 240px, 45vw"
              quality={65}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full rounded-xl object-cover"
            />
          ))}
        </div>
      </section>
    )}

    {cardImages.length > 0 && (
      <section class="mt-16">
        <h2 class="font-serif text-2xl">한 장씩 넘겨보기</h2>
        <p class="mt-1 text-sm text-slate-400">옆으로 밀어서 볼 수 있습니다.</p>
        <div class="-mx-6 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-3">
          {cardImages.map((card, i) => (
            <Image
              src={card!}
              alt={`${title} 카드 ${i + 1}`}
              widths={[320, 640]}
              sizes="280px"
              quality={72}
              loading="lazy"
              decoding="async"
              class="w-[280px] shrink-0 snap-start rounded-2xl"
            />
          ))}
        </div>
      </section>
    )}

    <slot />
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* 딥다이브는 시즌 페이지와 다른 에디토리얼 톤을 유지한다 */
  .neighborhood {
    --accent: #c4507a;
  }
  .neighborhood :global(.font-serif) {
    font-family: 'Shippori Mincho', 'Iowan Old Style', Georgia, serif;
  }
</style>
